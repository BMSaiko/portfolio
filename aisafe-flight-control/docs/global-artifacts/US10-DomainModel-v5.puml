@startuml
allowmixing
skinparam shadowing false
skinparam classAttributeIconSize 0

' ============================================================
'  AISafe Domain Model v5
'  Updated for US090, US107, US111, US112, US121 (Sprint 3 additions)
'  Copy of v4 with DDD-valid changes only
' ============================================================
'  ANÁLISE POR US:
'  US090 - Remote Access Logging (UDP)  → INFRAESTRUTURA (cross-cutting)
'           Logging Server é serviço externo, não entidade do domínio núcleo.
'           NÃO adiciona ao domain model DDD.
'
'  US107 - Condition Variable signaling → INFRAESTRUTURA SCOMP (threads POSIX)
'           Sincronização entre threads C não é conceito de domínio.
'           NÃO adiciona ao domain model DDD.
'
'  US111 - Simulation Report            → DOMÍNIO (resultado de simulação)
'           SimulationReport como Aggregate com ViolationSummary.
'           SafetyViolationReport como Value Object com posições/vectores.
'
'  US112 - Monthly Report               → DOMÍNIO (relatório periódico)
'           MonthlyReport como Aggregate com estatísticas agregadas.
'           MonthlyReportPeriod como Value Object.
'
'  US121 - Create flight plan from file → DOMÍNIO (importação DSL)
'           FlightPlanFile como Value Object (raw content para parsing).
'           FlightPlanSource enum (MANUAL | FILE).
' ============================================================

package "User Aggregate" {
    class User <<entity>><<root>> {
        email <<id>> <<embedded>>
        passwordHash
        name
        phoneNumber
        securityClearanceExpiry
        lastSkillsAssessment
        active
        version
    }

    class Email <<value object>> {
        address
    }

    enum Role {
        ADMIN
        BACKOFFICE_OPERATOR
        COLLABORATOR
        AIR_TRANSPORT_COMPANY_COLLABORATOR
        PILOT
        FLIGHT_CONTROL_OPERATOR
        WEATHER_PERSON
    }
}

package "Organisation Aggregate" {
    class AirTransportCompany <<entity>><<root>> {
        iataCode <<id>> <<embedded>>
        icaoCode <<embedded>>
        companyName
    }

    class CompanyIataCode <<value object>> {
        code
    }

    class CompanyIcaoCode <<value object>> {
        code
    }

    class CustomerCollaborator <<entity>> {
        customerCode
        userEmail
        position
    }
}

package "AircraftModel Aggregate" {
    class AircraftModel <<entity>><<root>> {
        aircraftType
        emptyWeight
        mtow
        mzfw
        maxFuelCapacity
        serviceCeiling
        cruiseSpeedMach
        wingArea
        wingSpan
        aspectRatio
        oswaldFactor
        dragCoefficient
        liftCoefficient
        numberOfEngines
        maxPassengerCapacity
        maxRange
    }

    class AircraftModelId <<value object>> {
        modelId
        makerName
    }

    enum AircraftType {
        PASSENGER
        CARGO
        MIXED
    }
}

package "EngineModel Aggregate" {
    class EngineModel <<entity>><<root>> {
        engineType
        thrustAtStandstill
        thrustAtCruiseSpeed
        cruiseSpeedMach
        tsfc
        lapseRateFactor
        fuelType
    }

    class EngineModelId <<value object>> {
        name
        makerId
    }

    enum EngineType {
        TURBOPROP
        TURBOFAN
        TURBOJET
        RAMJET
        ELECTRIC_PROPELLER
    }

    enum FuelType {
        JET_A1
        JET_A
        AVGAS
    }
}

package "Aircraft Aggregate" {
    class Aircraft <<entity>><<root>> {
        registration <<id>> <<embedded>>
        country
        manufacturingYear
    }

    class Registration <<value object>> {
        number
    }

    class CabinConfiguration <<value object>> {
        firstClassSeats
        businessSeats
        economySeats
    }

    enum OperationalStatus {
        ACTIVE
        RETIRED
    }
}

package "AirControlArea Aggregate" {
    class AirControlArea <<entity>><<root>> {
        areaCode <<id>> <<embedded>>
        name
        minimumFuelRequired
    }

    class AirControlAreaCode <<value object>> {
        code
    }

    class GeoBoundary <<value object>> {
        northLatitude
        southLatitude
        eastLongitude
        westLongitude
    }
}

package "Airport Aggregate" {
    class Airport <<entity>><<root>> {
        iataCode <<id>> <<embedded>>
        name
        town
        country
    }

    class IataCode <<value object>> {
        code
    }

    class IcaoCode <<value object>> {
        code
    }

    class Coordinates <<value object>> {
        latitude
        longitude
        altitude
    }
}

package "Pilot Aggregate" {
    class Pilot <<entity>><<root>> {
        id <<id>>
        email <<embedded>>
        name
        position
        status
    }

    enum PilotStatus {
        ACTIVE
        INACTIVE
    }
}

package "Route Aggregate" {
    class FlightRoute <<entity>><<root>> {
        designator <<id>> <<embedded>>
        active
        deactivatedFrom
    }

    class RouteDesignator <<value object>> {
        value
    }
}

package "FlightPlan Aggregate" {
    class FlightPlan <<entity>><<root>> {
        id <<embedded>>
        departureAirport
        arrivalAirport
        totalDistance
        estimatedFuel
        departureDateTime
    }

    class FlightPlanId <<value object>> {
        id
    }

    enum FlightPlanStatus {
        DRAFT
        VALIDATED
        FAILED
        APPROVED
        ACTIVE
        COMPLETED
        CANCELLED
    }

    ' US121: Source of flight plan creation
    enum FlightPlanSource {
        MANUAL
        FILE
    }

    class FlightLeg <<entity>> {
        departureAirport
        arrivalAirport
        fuel
    }

    class FlightSegment <<value object>> {
        mode
        startCoordinate
        endCoordinate
        minAltitude
        maxAltitude
        width
        windDirection
        windSpeed
    }

    ' US121: Raw DSL file content for parsing (Sprint 3 LPROG)
    class FlightPlanFile <<value object>> {
        filename
        rawContent <<Lob>>
        fileSize
        uploadedAt
    }
}

package "Weather Aggregate" {
    class WeatherData <<entity>><<root>> {
        id <<id>>
    }

    class TimePeriod <<value object>> {
        start
        end
    }

    class Temperature <<value object>> {
        value
    }

    class WindSpeed <<value object>> {
        value
    }

    class WindDirection <<value object>> {
        value
    }

    class Humidity <<value object>> {
        value
    }

    class Pressure <<value object>> {
        value
    }
}

' ============================================================
'  US111 — Simulation Report Aggregate
'  Resultado da simulação (SCOMP). Agrega dados de execução,
'  status dos voos, violações de segurança detectadas e
'  resultado pass/fail final.
' ============================================================
' ============================================================
'  US111 — Simulation Report (reportmanagement bounded context)
'  Resultado da simulação SCOMP. Agrega status de cada voo,
'  violações de segurança detetadas e resultado pass/fail final.
'
'  Domain Java real ((reportmanagement/domain):
'    SimulationReport          — areaCode, timeStart/End, safetyThreshold, flights, violations
'    FlightSimulationResult    — flightId, status (COMPLETED/TERMINATED), historySteps, violationCount, finalLat/Lon/Alt
'    ViolationDetail           — timeStep, flight1Id, flight2Id, distanceKm
'    ValidationResult           — PASS, FAIL_TERMINATED, FAIL_VIOLATIONS
'
'  NOTA: SimulationReport é um aggregate Java puro (não JPA entity).
'  ReportGenerator (C, SCOMP) escreve para ficheiro .txt.
'  MonthlyReportGenerator lê esses ficheiros do filesystem.
' ============================================================
package "Simulation Aggregate" {

    class SimulationReport <<entity>><<root>> {
        areaCode <<id>> <<embedded>>
        generatedAt
        timeStart
        timeEnd
        timeStepSecs
        totalSteps
        safetyThreshold
        numFlights
        validationResult
        validationReason
    }

    class FlightSimulationResult <<value object>> {
        flightId
        status
        historySteps
        violationCount
        finalLat
        finalLon
        finalAltitude
    }

    enum FlightStatus {
        COMPLETED
        TERMINATED
    }

    class ViolationDetail <<value object>> {
        timeStep
        flight1Id
        flight2Id
        distanceKm
    }

    enum ValidationResult {
        PASS
        FAIL_TERMINATED
        FAIL_VIOLATIONS
    }
}

' ============================================================
'  US112 — Monthly Report (Reporting Bounded Context)
'  Relatório periódico mensal para compliance/admin.
'
'  Domain Java real (reportmanagement/domain):
'    MonthlyStatistics       — @Entity JPA (year, month, totals) — persistido para caching
'    ReportPeriod            — Value Object (year + month, factory method of())
'    ReportType              — Enum (MONTHLY, COMPLIANCE, INCIDENT)
'
'  Application layer (reportmanagement/application):
'    MonthlyReportGenerator  — estende ReportGenerator, usa FlightPlanRepository
'    MonthlyReportService    — autoriza (ADMIN/FCO), gera, persiste MonthlyStatistics
'    ReportGenerator         — abstract base (Template Method: collectData → buildSections → writeToFile)
'
'  NOTA: Não há relação estrutural com SimulationReport.
'  MonthlyReportGenerator lê simulation reports do filesystem (reports/simulation/*.txt)
'  e FlightPlanRepository. SimulationReport não conhece MonthlyStatistics.
'  Cada aggregate vive no seu package, sem setas entre si.
' ============================================================
package "Reporting Aggregate" {

    class MonthlyStatistics <<entity>><<root>> {
        id <<id>> <<generated>>
        year
        month
        totalFlights
        validatedFlights
        completedFlights
        cancelledFlights
        totalDistance
        totalFuel
        generatedAt
    }

    class ReportPeriod <<value object>> {
        year
        month
        startDate()
        endDate()
    }

    enum ReportType {
        MONTHLY
        COMPLIANCE
        INCIDENT
    }
}

' ============================================================
'  Relationships
' ============================================================

' -- User Aggregate --
User "1" *-- "1" Email : "identity @EmbeddedId"
User "1" *-- "1..*" Role : "roles @ElementCollection"

' -- Organisation --
AirTransportCompany "1" *-- "1" CompanyIataCode : "identity @EmbeddedId"
AirTransportCompany "1" *-- "1" CompanyIcaoCode : "has @Embedded"
AirTransportCompany "1" --> "0..*" CustomerCollaborator : "has collaborators"
CustomerCollaborator "1" --> "1" Email : "userEmail @Embedded"

' -- AircraftModel --
AircraftModel "1" *-- "1" AircraftModelId : "identity @EmbeddedId"
AircraftModel "1" *-- "1" AircraftType : "classified as"
AircraftModel "1" --> "1..*" EngineModel : "certifiedEngines @ManyToMany"

' -- EngineModel --
EngineModel "1" *-- "1" EngineModelId : "identity @EmbeddedId"
EngineModel "1" *-- "1" EngineType : "classified as"
EngineModel "1" *-- "1" FuelType : "uses"

' -- Aircraft --
Aircraft "1" *-- "1" Registration : "identity @EmbeddedId"
Aircraft "1" *-- "1" CabinConfiguration : "has @Embedded"
Aircraft "1" *-- "1" OperationalStatus : "has @Enumerated"
Aircraft "1" --> "1" AircraftModel : "model @ManyToOne"
Aircraft "1" --> "1" AirTransportCompany : "company @ManyToOne"

' -- AirControlArea --
AirControlArea "1" *-- "1" AirControlAreaCode : "identity @EmbeddedId"
AirControlArea "1" *-- "1" GeoBoundary : "bounded by @Embedded"

' -- Airport --
Airport "1" *-- "1" IataCode : "identity @EmbeddedId"
Airport "1" *-- "1" IcaoCode : "has @Embedded"
Airport "1" *-- "1" Coordinates : "located at @Embedded"
Airport "1" --> "1" AirControlArea : "belongs to @ManyToOne"

' -- Pilot --
Pilot "1" --> "1" User : "systemUser @OneToOne"
Pilot "1" *-- "1" Email : "email @Embedded"
Pilot "1" --> "1" AirTransportCompany : "company @ManyToOne"
Pilot "1" --> "1..*" AircraftModel : "certifications @ManyToMany"
Pilot "1" *-- "1" PilotStatus : "status @Enumerated"

' -- Route --
FlightRoute "1" *-- "1" RouteDesignator : "identity @EmbeddedId"
FlightRoute "1" --> "1" AirTransportCompany : "company @ManyToOne"
FlightRoute "1" --> "1" Airport : "origin @ManyToOne"
FlightRoute "1" --> "1" Airport : "destination @ManyToOne"

' -- FlightPlan --
FlightPlan "1" *-- "1" FlightPlanId : "identity @EmbeddedId"
FlightPlan "1" *-- "1" FlightPlanStatus : "status @Enumerated"
FlightPlan "1" *-- "1" FlightPlanSource : "source @Enumerated"
FlightPlan "1" *-- "0..1" FlightPlanFile : "file @Embedded"
FlightPlan "1" *-- "1..*" FlightLeg : "legs @OneToMany cascade"
FlightPlan "1" --> "1" FlightRoute : "route @ManyToOne"
FlightPlan "1" --> "1" Aircraft : "aircraft @ManyToOne"
FlightPlan "1" --> "1" AircraftModel : "aircraftModel @ManyToOne"
FlightPlan "1" --> "1" Pilot : "pilot @ManyToOne"
FlightPlan "0..*" --> "0..*" WeatherData : "weatherData @ManyToMany"
FlightLeg "1" *-- "1..*" FlightSegment : "segments @ElementCollection"

' -- Weather --
WeatherData "1" --> "1" AirControlArea : "area @ManyToOne"
WeatherData "1" *-- "1" TimePeriod : "period @Embedded"
WeatherData "1" *-- "1" Temperature : "temperature @Embedded"
WeatherData "1" *-- "1" WindSpeed : "windSpeed @Embedded"
WeatherData "1" *-- "1" WindDirection : "windDirection @Embedded"
WeatherData "1" *-- "1" Humidity : "humidity @Embedded"
WeatherData "1" *-- "1" Pressure : "pressure @Embedded"

' -- Simulation Report (US111) --
SimulationReport "1" *-- "0..*" FlightSimulationResult : "flights"
SimulationReport "1" *-- "0..*" ViolationDetail : "violations"
SimulationReport "1" *-- "1" ValidationResult : "validationResult @Enumerated"
FlightSimulationResult "1" *-- "1" FlightStatus : "status @Enumerated"

' -- Monthly Report (US112) --
MonthlyStatistics "1" *-- "1" ReportPeriod : "period"
MonthlyStatistics "1" --> "0..*" FlightPlan : "flightPlans @ManyToOne (via MonthlyReportGenerator)"
MonthlyStatistics "1" --> "0..*" AircraftModel : "aircraftModels @ManyToOne (via MonthlyReportGenerator)"

@enduml
