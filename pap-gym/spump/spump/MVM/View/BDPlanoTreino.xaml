<Window x:Class="spump.MVM.View.BDPlanoTreino"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:spump.MVM.View"
        mc:Ignorable="d"
        Title="BDPlanoTreino" 
        Height="600" Width="920"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">



    <Border Background="#202020"
            CornerRadius="20">
        <Grid>


            <Grid.RowDefinitions>
                <RowDefinition Height="75"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Text="Spump"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="Red"
                       FontSize="22"
                       Margin="20,0,0,0"/>



            <Button x:Name="CloseMainwindow" Grid.Column="1"
                    Style="{StaticResource CloseButton}" Click="CloseMainwindow_Click"/>

            <StackPanel Orientation="Horizontal" Grid.Row="2">
                <Border  CornerRadius="20">
                    <Border.Clip>
                        <RectangleGeometry RadiusX="20"
                                   RadiusY="20"
                                   Rect="0,0,510,525"/>
                    </Border.Clip>
                    <Grid>
                        <DataGrid 
                          x:Name="exercicios" Width="510" Height="525" Margin="0,0,0,0" Background="Transparent"
                              HeadersVisibility="Column"
                              GridLinesVisibility="none"
                              BorderThickness="0"
                              BorderBrush="Transparent"
                              Foreground="Black"
                          MaxHeight="600"
                          ScrollViewer.CanContentScroll="True" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="exercicios_SelectionChanged" SelectedCellsChanged="exercicios_SelectedCellsChanged" />

                    </Grid>
                </Border>

                <StackPanel Orientation="Vertical" Margin="20,0,0,0" x:Name="StackExer">
                    <TextBlock x:Name="N1" Foreground="White" FontSize="14" Text="-" Width="380" Height="55" MaxWidth="300" Margin="0,0,0,0" MouseDown="N1_MouseDown"/>
                    <TextBlock x:Name="N2" Foreground="White" FontSize="14" Text="-" Width="380" Height="55" MaxWidth="300" Margin="0,0,0,0" MouseDown="N2_MouseDown"/>
                    <TextBlock x:Name="N3" Foreground="White" FontSize="14" Text="-" Width="380" Height="55" MaxWidth="300" Margin="0,0,0,0" MouseDown="N3_MouseDown"/>
                    <TextBlock x:Name="N4" Foreground="White" FontSize="14" Text="-" Width="380" Height="55" MaxWidth="300" Margin="0,0,0,0" MouseDown="N4_MouseDown"/>
                    <TextBlock x:Name="N5" Foreground="White" FontSize="14" Text="-" Width="380" Height="55" MaxWidth="300" Margin="0,0,0,0" MouseDown="N5_MouseDown"/>
                    <TextBlock x:Name="N6" Foreground="White" FontSize="14" Text="-" Width="380" Height="55" MaxWidth="300" Margin="0,0,0,0" MouseDown="N6_MouseDown"/>
                    <TextBlock x:Name="N7" Foreground="White" FontSize="14" Text="-" Width="380" Height="55" MaxWidth="300" Margin="0,0,0,0" MouseDown="N7_MouseDown"/>


                    <Border CornerRadius="10"
                            Background="#353340"
                            Width="200" Height="40" Margin="-100,20,0,0">

                        <Grid>
                            <Rectangle StrokeThickness="1"/>
                            <TextBox x:Name="planoTxt"                                      
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Padding="5"
                                     Foreground="#cfcfcf" Width="200" Height="40"/>
                        </Grid>
                    </Border>
                    
                    <Button Width="100" Height="30" Margin="200,-40,0,0" Content="✓" Click="Button_Click" Style="{StaticResource ButtonTheme}"/>
                </StackPanel>

            </StackPanel>


        </Grid>
    </Border>




</Window>
