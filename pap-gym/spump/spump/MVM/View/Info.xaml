<Window x:Class="spump.MVM.View.Info"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:spump.MVM.View"
        mc:Ignorable="d"
        Title="Info" Height="600" Width="920"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">



    <Border Background="#202020"
            CornerRadius="20">
        <Grid>


            <Grid.RowDefinitions>
                <RowDefinition Height="75"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Text="Spump"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="Red"
                       FontSize="22"
                       Margin="20,0,0,0"/>



            <Button x:Name="CloseMainwindow" Grid.Column="1"
                    Style="{StaticResource CloseButton}" Click="CloseMainwindow_Click"/>


            <StackPanel Orientation="Horizontal" Grid.Row="2">
                <Border  Height="450" Width="600" Margin="150,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
            CornerRadius="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                            <GradientStop Color="#ff3333" Offset="0.0"/>
                            <GradientStop Color="#990000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid Margin="20,10,20,10">
                        <TextBlock  VerticalAlignment="Center" Text="O Spump, é uma aplicação desenvolvida para facilitar e agilizar o atendimento&#x0a;dos clientes nos quais ferquentam os ginásios Spump.&#x0a;Este projeto foi realizado pelo Bruno Miguel da Silva, caso necessite de alguma&#x0a;informação ligue: 916277685 ou envie um email: 17337@aedas.edu.pt." FontSize="16" Foreground="White"/>
                    </Grid>
                </Border>
            </StackPanel>

        </Grid>
    </Border>
</Window>
