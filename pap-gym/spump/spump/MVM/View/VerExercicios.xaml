<Window x:Class="spump.MVM.View.VerExercicios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:spump.MVM.View"
        mc:Ignorable="d"
        Title="VerExercicios" Height="600" Width="920"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">



    <Border Background="#202020"
            CornerRadius="20">
        <Grid>


            <Grid.RowDefinitions>
                <RowDefinition Height="75"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Text="Spump"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Foreground="Red"
                       FontSize="22"
                       Margin="20,0,0,0"/>



            <Button x:Name="CloseMainwindow" Grid.Column="1"
                    Style="{StaticResource CloseButton}" Click="CloseMainwindow_Click"/>

            <StackPanel Orientation="Horizontal" Grid.Row="2">

                <StackPanel.Resources>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Margin" Value="0,20,0,0"/>
                        <Setter Property="Margin" Value="0,20,0,0"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Width" Value="170"/>
                    </Style>
                </StackPanel.Resources>
                <Label x:Name="I" Margin="50,-150,0,0" Width="300" Height="300"/>

                
                
                <StackPanel Orientation="Vertical" Margin="50,40,0,0">
                    

                    <TextBlock Text="Nome" Margin="0,0,0,0" Foreground="White"/>
                    <TextBlock Text="Series" Foreground="White"/>
                    <TextBlock Text="Repetições" Foreground="White"/>
                    <TextBlock Text="Descanso" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,40,0,0">

                    <TextBlock x:Name="t1" Text="banana" Margin="0,0,0,0" Foreground="White"/>
                    <TextBlock x:Name="t2" Text="banana" Foreground="White"/>
                    <TextBlock x:Name="t3" Text="banana" Foreground="White"/>
                    <TextBlock x:Name="t4" Text="banana" Foreground="White"/>
                </StackPanel>
            </StackPanel>


        </Grid>
    </Border>
</Window>
