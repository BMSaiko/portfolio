package "pt.isep.dei.esinf.utils.graph" {
    class Edge<V, E> {
        - vOrig: V
        - vDest: V
        - weight: E
    }
    
    class Algorithms {
        + {static} BreadthFirstSearch(g: Graph, vert: V): LinkedList<V>
        + {static} DepthFirstSearch(g: Graph, vert: V): LinkedList<V>
        + {static} allPaths(g: Graph, vOrig: V, vDest: V): ArrayList<LinkedList<V>>
        + {static} shortestPath(g: Graph, vOrig: V, vDest: V): LinkedList<V>
        + {static} shortestPaths(g: Graph, vOrig: V): ArrayList<LinkedList<V>>
    }
    
    class CommonGraph<V, E> {
        # isDirected: boolean
        # numVerts: int
        # numEdges: int
        + isDirected(): boolean
        + numVertices(): int
        + numEdges(): int
    }
    
    interface Graph<V, E> {
        + isDirected(): boolean
        + numVertices(): int
        + vertices(): ArrayList<V>
        + validVertex(vert: V): boolean
        + key(vert: V): int
        + vertex(key: int): V
        + vertex(p: Predicate<V>): V
        + adjVertices(vert: V): Collection<V>
        + numEdges(): int
        + edges(): Collection<Edge<V, E>>
        + edge(vOrig: V, vDest: V): Edge<V, E>
        + edge(vOrigKey: int, vDestKey: int): Edge<V, E>
        + outDegree(vert: V): int
        + inDegree(vert: V): int
        + outgoingEdges(vert: V): Collection<Edge<V, E>>
        + incomingEdges(vert: V): Collection<Edge<V, E>>
        + addVertex(vert: V): boolean
        + addEdge(vOrig: V, vDest: V, weight: E): boolean
        + removeVertex(vert: V): boolean
        + removeEdge(vOrig: V, vDest: V): boolean
    }
    
    class MapGraph<V, E> {
        - mapVertices: Map<V, MapVertex>
        + validVertex(vert: V): boolean
        + adjVertices(vert: V): Collection<V>
        + edges(): Collection<Edge>
        + edge(vOrig: V, vDest: V): Edge
        + outDegree(vert: V): int
        + inDegree(vert: V): int
        + addVertex(vert: V): boolean
        + addEdge(vOrig: V, vDest: V, weight: E): boolean
        + removeVertex(vert: V): boolean
        + removeEdge(vOrig: V, vDest: V): boolean
    }
    
    class MapVertex<V, E> {
        - outVerts: Map<V, Edge>
        + numAdjVerts(): int
        + getAllOutEdges(): Collection<Edge>
        + getAllAdjVerts(): Collection<V>
        + getEdge(vAdj: V): Edge
        + addAdjVert(vAdj: V, edge: Edge): void
        + remAdjVert(vAdj: V): void
    }
    MinimalBackboneService --> RailwayNetworkRepository : uses
    MinimalBackboneService ..> Graph : uses
    MinimalBackboneService ..> Algorithms : uses
    MinimalBackboneService --> Edge : processes
    MinimalBackboneService --> TrackConnection : uses
    MinimalBackboneService --> Station : uses

    RailwayUpgradeService --> RailwayNetworkRepository : uses
    RailwayUpgradeService ..> UpgradePlanResult : creates
    RailwayUpgradeService ..> CycleInfo : creates
    RailwayUpgradeService --> Station : processes

}  

