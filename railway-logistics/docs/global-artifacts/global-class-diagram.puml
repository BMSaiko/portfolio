package "pt.isep.dei.esinf.service.warehouse" {
    class WarehouseAllocator {
        + allocateBoxesToWarehouse(boxes: List<Box>, warehouse: Warehouse): void
    }
    
    class WarehouseManagementService {
        - orderAllocationService: OrderAllocationService
        - trolleyPackingService: TrolleyPackingService
        + displayBayContents(warehouse: Warehouse): void
        + dispatchSku(warehouse: Warehouse, sku: String, qty: int): boolean
        + displayInventoryBySku(warehouse: Warehouse): void
