@startuml
allowmixing
skinparam shadowing false
skinparam classAttributeIconSize 0

' ============================================================
'  AISafe Domain Model v5
'  Updated for US042, US043, US074 and US082
' ============================================================

package "User Aggregate" {
    class User <<entity>><<root>> {
        email <<id>> <<embedded>>
        passwordHash
        name
        phoneNumber
        securityClearanceExpiry
        lastSkillsAssessment
        active
        version
    }

    class Email <<value object>> {
        address
    }

    enum Role {
        ADMIN
        BACKOFFICE_OPERATOR
        COLLABORATOR
        AIR_TRANSPORT_COMPANY_COLLABORATOR
        PILOT
        FLIGHT_CONTROL_OPERATOR
        WEATHER_PERSON
    }
}

package "Organisation Aggregate" {
    class AirTransportCompany <<entity>><<root>> {
        iataCode <<id>> <<embedded>>
        icaoCode <<embedded>>
        companyName
    }

    class CompanyIataCode <<value object>> {
        code
    }

    class CompanyIcaoCode <<value object>> {
        code
    }

    class CustomerCollaborator <<entity>> {
        customerCode
        userEmail
        position
    }
}

package "AircraftModel Aggregate" {
    class AircraftModel <<entity>><<root>> {
        aircraftType
        emptyWeight
        mtow
        mzfw
        maxFuelCapacity
        serviceCeiling
        cruiseSpeedMach
        wingArea
        wingSpan
        aspectRatio
        oswaldFactor
        dragCoefficient
        liftCoefficient
        numberOfEngines
        maxPassengerCapacity
        maxRange
    }

    class AircraftModelId <<value object>> {
        modelId
        makerName
    }

    enum AircraftType {
        PASSENGER
        CARGO
        MIXED
    }
}

package "EngineModel Aggregate" {
    class EngineModel <<entity>><<root>> {
        engineType
        thrustAtStandstill
        thrustAtCruiseSpeed
        cruiseSpeedMach
        tsfc
        lapseRateFactor
        fuelType
    }

    class EngineModelId <<value object>> {
        name
        makerId
    }

    enum EngineType {
        TURBOPROP
        TURBOFAN
        TURBOJET
        RAMJET
        ELECTRIC_PROPELLER
    }

    enum FuelType {
        JET_A1
        JET_A
        AVGAS
    }
}

package "Aircraft Aggregate" {
    class Aircraft <<entity>><<root>> {
        registration <<id>> <<embedded>>
        country
        manufacturingYear
    }

    class Registration <<value object>> {
        number
    }

    class CabinConfiguration <<value object>> {
        firstClassSeats
        businessSeats
        economySeats
    }

    enum OperationalStatus {
        ACTIVE
        RETIRED
    }
}

package "AirControlArea Aggregate" {
    class AirControlArea <<entity>><<root>> {
        areaCode <<id>> <<embedded>>
        name
        minimumFuelRequired
    }

    class AirControlAreaCode <<value object>> {
        code
    }

    class GeoBoundary <<value object>> {
        northLatitude
        southLatitude
        eastLongitude
        westLongitude
    }
}

package "Airport Aggregate" {
    class Airport <<entity>><<root>> {
        iataCode <<id>> <<embedded>>
        name
        town
        country
    }

    class IataCode <<value object>> {
        code
    }

    class IcaoCode <<value object>> {
        code
    }

    class Coordinates <<value object>> {
        latitude
        longitude
        altitude
    }
}

package "Pilot Aggregate" {
    class Pilot <<entity>><<root>> {
        id <<id>>
        email <<embedded>>
        name
        position
        status
    }

    enum PilotStatus {
        ACTIVE
        INACTIVE
    }
}

package "Route Aggregate" {
    class FlightRoute <<entity>><<root>> {
        designator <<id>> <<embedded>>
        active
        deactivatedFrom
    }

    class RouteDesignator <<value object>> {
        value
    }
}

package "FlightPlan Aggregate" {
    class FlightPlan <<entity>><<root>> {
        id <<embedded>>
        departureAirport
        arrivalAirport
        totalDistance
        estimatedFuel
        departureDateTime
    }

    class FlightPlanId <<value object>> {
        id
    }

    enum FlightPlanStatus {
        DRAFT
        VALIDATED
        FAILED
        APPROVED
        ACTIVE
        COMPLETED
        CANCELLED
    }

    class FlightLeg <<entity>> {
        departureAirport
        arrivalAirport
        fuel
    }

    class FlightSegment <<value object>> {
        mode
        startCoordinate
        endCoordinate
        minAltitude
        maxAltitude
        width
        windDirection
        windSpeed
    }
}

package "Weather Aggregate" {
    class WeatherData <<entity>><<root>> {
        id <<id>>
    }

    class TimePeriod <<value object>> {
        start
        end
    }

    class Temperature <<value object>> {
        value
    }

    class WindSpeed <<value object>> {
        value
    }

    class WindDirection <<value object>> {
        value
    }

    class Humidity <<value object>> {
        value
    }

    class Pressure <<value object>> {
        value
    }
}

' ============================================================
'  Relationships
' ============================================================

' -- User Aggregate --
User "1" *-- "1" Email : "identity @EmbeddedId"
User "1" *-- "1..*" Role : "roles @ElementCollection"

' -- Organisation --
AirTransportCompany "1" *-- "1" CompanyIataCode : "identity @EmbeddedId"
AirTransportCompany "1" *-- "1" CompanyIcaoCode : "has @Embedded"
AirTransportCompany "1" --> "0..*" CustomerCollaborator : "has collaborators"
CustomerCollaborator "1" --> "1" Email : "userEmail @Embedded"

' -- AircraftModel --
AircraftModel "1" *-- "1" AircraftModelId : "identity @EmbeddedId"
AircraftModel "1" *-- "1" AircraftType : "classified as"
AircraftModel "1" --> "1..*" EngineModel : "certifiedEngines @ManyToMany"

' -- EngineModel --
EngineModel "1" *-- "1" EngineModelId : "identity @EmbeddedId"
EngineModel "1" *-- "1" EngineType : "classified as"
EngineModel "1" *-- "1" FuelType : "uses"

' -- Aircraft --
Aircraft "1" *-- "1" Registration : "identity @EmbeddedId"
Aircraft "1" *-- "1" CabinConfiguration : "has @Embedded"
Aircraft "1" *-- "1" OperationalStatus : "has @Enumerated"
Aircraft "1" --> "1" AircraftModel : "model @ManyToOne"
Aircraft "1" --> "1" AirTransportCompany : "company @ManyToOne"

' -- AirControlArea --
AirControlArea "1" *-- "1" AirControlAreaCode : "identity @EmbeddedId"
AirControlArea "1" *-- "1" GeoBoundary : "bounded by @Embedded"

' -- Airport --
Airport "1" *-- "1" IataCode : "identity @EmbeddedId"
Airport "1" *-- "1" IcaoCode : "has @Embedded"
Airport "1" *-- "1" Coordinates : "located at @Embedded"
Airport "1" --> "1" AirControlArea : "belongs to @ManyToOne"

' -- Pilot --
Pilot "1" --> "1" User : "systemUser @OneToOne"
Pilot "1" *-- "1" Email : "email @Embedded"
Pilot "1" --> "1" AirTransportCompany : "company @ManyToOne"
Pilot "1" --> "1..*" AircraftModel : "certifications @ManyToMany"
Pilot "1" *-- "1" PilotStatus : "status @Enumerated"

' -- Route --
FlightRoute "1" *-- "1" RouteDesignator : "identity @EmbeddedId"
FlightRoute "1" --> "1" AirTransportCompany : "company @ManyToOne"
FlightRoute "1" --> "1" Airport : "origin @ManyToOne"
FlightRoute "1" --> "1" Airport : "destination @ManyToOne"

' -- FlightPlan --
FlightPlan "1" *-- "1" FlightPlanId : "identity @EmbeddedId"
FlightPlan "1" *-- "1" FlightPlanStatus : "status @Enumerated"
FlightPlan "1" *-- "1..*" FlightLeg : "legs @OneToMany cascade"
FlightPlan "1" --> "1" FlightRoute : "route @ManyToOne"
FlightPlan "1" --> "1" Aircraft : "aircraft @ManyToOne"
FlightPlan "1" --> "1" AircraftModel : "aircraftModel @ManyToOne"
FlightPlan "1" --> "1" Pilot : "pilot @ManyToOne"
FlightPlan "0..*" --> "0..*" WeatherData : "weatherData @ManyToMany"
FlightLeg "1" *-- "1..*" FlightSegment : "segments @ElementCollection"

' -- Weather --
WeatherData "1" --> "1" AirControlArea : "area @ManyToOne"
WeatherData "1" *-- "1" TimePeriod : "period @Embedded"
WeatherData "1" *-- "1" Temperature : "temperature @Embedded"
WeatherData "1" *-- "1" WindSpeed : "windSpeed @Embedded"
WeatherData "1" *-- "1" WindDirection : "windDirection @Embedded"
WeatherData "1" *-- "1" Humidity : "humidity @Embedded"
WeatherData "1" *-- "1" Pressure : "pressure @Embedded"

@enduml